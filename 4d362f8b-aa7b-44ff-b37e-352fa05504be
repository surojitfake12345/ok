*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;font-family:var(--font);font-size:var(--fs-md);line-height:1.6;color:var(--text);background:var(--bg)}
a{color:var(--c-primary-600);text-decoration:none}
a:hover{text-decoration:underline}
:focus-visible{outline:3px solid var(--c-primary);outline-offset:2px;border-radius:4px}
.wrap{max-width:var(--bp-lg);margin:0 auto;padding:0 var(--s4)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
header.top{border-bottom:1px solid var(--border);background:var(--bg)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
.brand{display:flex;align-items:center;gap:var(--s2);color:var(--text);font-weight:var(--w-med);font-size:1.25rem;letter-spacing:-.4px}
.brand:hover{text-decoration:none}
.brand b{font-weight:var(--w-reg);opacity:.85}
nav a{margin-left:var(--s4);color:var(--muted);font-size:var(--fs-sm)}
.hero{text-align:center;padding:var(--s7) 0 var(--s6)}
.hero h1{font-size:var(--fs-xl);line-height:1.2;margin:var(--s4) 0 var(--s2);letter-spacing:-.5px;font-weight:var(--w-med)}
.hero p{color:var(--muted);margin:0 auto var(--s5);max-width:520px}
.search{display:block;max-width:520px;margin:0 auto}
input[type=text],input[type=number],input[type=date],select,textarea,input[type=search]{width:100%;font:inherit;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);padding:12px var(--s4);min-height:48px}
textarea{resize:vertical;min-height:140px}
input:focus,select:focus,textarea:focus{border-color:var(--c-primary)}
h2{font-size:var(--fs-lg);margin:var(--s6) 0 var(--s3);font-weight:var(--w-med)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:var(--s3)}
.card{display:block;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:var(--s4) var(--s5);color:var(--text);box-shadow:var(--sh-1)}
a.card:hover{text-decoration:none;border-color:var(--c-primary);box-shadow:var(--sh-2)}
.card strong{display:block;font-weight:var(--w-med)}
.card span{display:block;color:var(--muted);font-size:var(--fs-sm)}
.card.soon{opacity:.65;border-style:dashed}
.card span.tag,.tag{display:inline-block;font-size:12px;padding:2px 10px;border-radius:var(--r-pill);background:var(--c-primary-100);color:var(--c-primary-600);margin-bottom:var(--s2)}
.empty{display:none;color:var(--muted);text-align:center;padding:var(--s5)}
.crumb{font-size:var(--fs-sm);color:var(--muted);padding:var(--s4) 0 0}
h1.t{font-size:var(--fs-xl);margin:var(--s2) 0;font-weight:var(--w-med);letter-spacing:-.4px}
.lead{color:var(--muted);margin:0 0 var(--s5)}
.tool{display:grid;gap:var(--s5);grid-template-columns:1fr}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:var(--s5)}
.field{margin-bottom:var(--s4)}
.field label{display:block;font-size:var(--fs-sm);font-weight:var(--w-med);margin-bottom:var(--s1)}
.field .hint{font-size:12px;color:var(--muted);margin-top:var(--s1)}
.check{display:flex;align-items:center;gap:var(--s2);margin-bottom:var(--s2);font-size:var(--fs-md)}
.check input{width:20px;height:20px}
.res-row{display:flex;justify-content:space-between;gap:var(--s4);padding:var(--s3) 0;border-bottom:1px solid var(--border)}
.res-row:last-child{border-bottom:0}
.res-row span{color:var(--muted)}
.res-row strong{text-align:right;font-weight:var(--w-med)}
.res-row.main strong{font-size:var(--fs-lg);color:var(--c-primary-600)}
.msg{color:var(--muted)}
.msg.err{color:var(--c-danger)}
button,.btn{font:inherit;font-weight:var(--w-med);background:var(--c-primary);color:#fff;border:0;border-radius:var(--r-md);padding:12px var(--s5);min-height:48px;cursor:pointer}
button:hover{background:var(--c-primary-600)}
button.ghost{background:transparent;color:var(--c-primary-600);border:1px solid var(--border)}
.actions{display:flex;gap:var(--s2);flex-wrap:wrap;margin-top:var(--s3)}
.pw{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:1.1rem;word-break:break-all}
footer{margin-top:var(--s8);border-top:1px solid var(--border);padding:var(--s5) 0;color:var(--muted);font-size:var(--fs-sm)}
@media (min-width:720px){.tool{grid-template-columns:1fr 1fr;align-items:start}.hero h1{font-size:var(--fs-2xl)}}
.logo-anim .f,.logo-anim .d{opacity:0;transform-box:fill-box;transform-origin:50% 100%}
.logo-anim .f1{animation:lf .5s cubic-bezier(.2,.7,.2,1) .1s forwards}
.logo-anim .f2{animation:lf .5s cubic-bezier(.2,.7,.2,1) .28s forwards}
.logo-anim .f3{animation:lf .5s cubic-bezier(.2,.7,.2,1) .46s forwards}
.logo-anim .d{transform-origin:50% 50%;animation:ld .45s cubic-bezier(.3,1.3,.5,1) .8s forwards}
@keyframes lf{from{opacity:0;transform:translateY(8px) scale(.92)}to{opacity:1;transform:none}}
@keyframes ld{from{opacity:0;transform:translateY(-10px) scale(.6)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.logo-anim .f,.logo-anim .d{opacity:1;animation:none}}
