/* ---------- homepage ---------- */
const cards = TOOLS.map((t) => `<a class="card" href="tools/${t.slug}.html" data-search="${esc((t.name + ' ' + t.desc + ' ' + t.cat).toLowerCase())}"><span class="tag">${t.cat}</span><strong>${esc(t.name)}</strong><span>${esc(t.desc)}</span></a>`).join('\n');
const soon = SOON.map((s) => `<div class="card soon"><span class="tag">Coming soon</span><strong>${esc(s.name)}</strong><span>${esc(s.desc)}</span></div>`).join('\n');
const home = page({
