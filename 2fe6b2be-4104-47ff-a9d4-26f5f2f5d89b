fs.writeFileSync(path.join(DIST, 'assets/favicon.svg'), symbolSvg(LIGHT, 11));
fs.writeFileSync(path.join(DIST, 'assets/logo-symbol-mono.svg'), `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,8 88,29 50,50 12,29" fill="#0F172A" fill-opacity=".45"/><polygon points="12,29 50,50 50,92 12,71" fill="#0F172A" fill-opacity=".75"/><polygon points="88,29 50,50 50,92 88,71" fill="#0F172A"/><circle cx="50" cy="29" r="8" fill="#fff"/></svg>`);
fs.writeFileSync(path.join(DIST, 'assets/app-icon.svg'), `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" rx="22" fill="#4F46E5"/><g transform="translate(16 16) scale(.68)"><polygon points="50,8 88,29 50,50 12,29" fill="#fff"/><polygon points="12,29 50,50 50,92 12,71" fill="#C7D2FE"/><polygon points="88,29 50,50 50,92 88,71" fill="#A5B4FC"/><circle cx="50" cy="29" r="9" fill="#4F46E5"/></g></svg>`);
fs.writeFileSync(path.join(DIST, 'assets/logo-horizontal.svg'), `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 260 64"><g transform="scale(.6)">${FACES(LIGHT)}<circle cx="50" cy="29" r="8" fill="#fff"/></g><text x="70" y="44" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Arial,sans-serif" font-size="36" font-weight="500" letter-spacing="-1" fill="#0F172A">Box<tspan font-weight="400" fill="#4F46E5">User</tspan></text></svg>`);

const SPRITE = `<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="bx" viewBox="0 0 100 100"><polygon points="50,8 88,29 50,50 12,29" fill="var(--lg-t)"/><polygon points="12,29 50,50 50,92 12,71" fill="var(--lg-l)"/><polygon points="88,29 50,50 50,92 88,71" fill="var(--lg-r)"/><circle cx="50" cy="29" r="8" fill="var(--lg-d)"/></symbol></svg>`;
const HERO_LOGO = `<svg class="logo-anim" width="72" height="72" viewBox="0 0 100 100" role="img" aria-label="BoxUser logo"><polygon class="f f1" points="50,8 88,29 50,50 12,29" fill="var(--lg-t)"/><polygon class="f f2" points="12,29 50,50 50,92 12,71" fill="var(--lg-l)"/><polygon class="f f3" points="88,29 50,50 50,92 88,71" fill="var(--lg-r)"/><circle class="d" cx="50" cy="29" r="8" fill="var(--lg-d)"/></svg>`;

/* ---------- assets: css + js bundle ---------- */
const css = (read('css/tokens.css') + read('css/site.css')).replace(/\n+/g, '\n');
fs.writeFileSync(path.join(DIST, 'assets/app.css'), css);
const js = ['js/calc.js', 'js/tools.js', 'js/ui.js'].map(read).join('\n');
fs.writeFileSync(path.join(DIST, 'assets/app.js'), js);

