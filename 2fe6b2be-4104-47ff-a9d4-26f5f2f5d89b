/* ---------- tool pages ---------- */
function field(f) {
  const id = esc(f.id);
  if (f.type === 'checkbox') return `<label class="check"><input type="checkbox" id="${id}"${f.value ? ' checked' : ''}> ${esc(f.label)}</label>`;
  let ctl;
  if (f.type === 'select') ctl = `<select id="${id}">${f.options.map((o) => `<option value="${esc(o[0])}"${o[0] === f.value ? ' selected' : ''}>${esc(o[1])}</option>`).join('')}</select>`;
  else if (f.type === 'textarea') ctl = `<textarea id="${id}" rows="${f.rows || 6}"></textarea>`;
  else {
    const at = ['step', 'min', 'max'].filter((k) => f[k] != null).map((k) => ` ${k}="${esc(f[k])}"`).join('');
    ctl = `<input id="${id}" type="${f.type}"${at}${f.type === 'number' ? ' inputmode="decimal"' : ''}${f.value ? ` value="${esc(f.value)}"` : ''}>`;
  }
  return `<div class="field"><label for="${id}">${esc(f.label)}</label>${ctl}${f.hint ? `<div class="hint">${esc(f.hint)}</div>` : ''}</div>`;
}
TOOLS.forEach((t) => {
  const others = TOOLS.filter((o) => o.slug !== t.slug).map((o) => `<a class="card" href="${o.slug}.html"><strong>${esc(o.name)}</strong></a>`).join('');
  const html = page({
    title: `${t.name} | BoxUser`, desc: t.desc, root: '../',
    body: `<main class="wrap">
<div class="crumb"><a href="../index.html">Home</a> / ${t.cat}</div>
<h1 class="t">${esc(t.name)}</h1>
<p class="lead">${esc(t.desc)}</p>
<div class="tool">
<form class="panel" id="tool-form" data-slug="${t.slug}" novalidate>${t.fields.map(field).join('')}</form>
<section class="panel" aria-live="polite" aria-label="Result"><div id="out"><p class="msg">Loading...</p></div></section>
</div>
<h2>More tools</h2><div class="grid">${others}</div>
</main>`
  });
  fs.writeFileSync(path.join(DIST, 'tools', t.slug + '.html'), html);
});

const size = (p) => fs.statSync(path.join(DIST, p)).size;
console.log('built', TOOLS.length, 'tool pages + index');
console.log('app.css', size('assets/app.css'), 'bytes | app.js', size('assets/app.js'), 'bytes');
